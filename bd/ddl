-- crear esquema si no existe
CREATE SCHEMA IF NOT EXISTS clinica;

-- crear tabla pacientes dentro del esquema clinica
CREATE TABLE clinica.pacientes (
    id SERIAL PRIMARY KEY,                        -- id autoincremental, PK
    nombre VARCHAR(100) NOT NULL,                 -- nombre obligatorio
    edad INT NOT NULL CHECK (edad >= 0),          -- edad obligatoria y no negativa
    obra_social VARCHAR(100) NOT NULL,            -- obra social obligatoria
    fecha_turno DATE NOT NULL                     -- fecha del turno obligatoria
);

-- test básico

SELECT 
    id
    ,nombre        
    ,edad   
    ,id                  
    ,fecha_turno
FROM   
    clinica.pacientes;